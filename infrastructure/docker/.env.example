# Operator-controlled values for compose.production.yaml. Never use these placeholders as real secrets.
POSTGRES_PASSWORD=replace-with-a-long-random-password
MIGRATION_DATABASE_URL=postgresql://fwo:URL_ENCODED_OWNER_PASSWORD@postgres:5432/fishing_world
DATABASE_URL=postgresql://fwo_app:URL_ENCODED_RUNTIME_PASSWORD@postgres:5432/fishing_world
JWT_SECRET=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=https://game.example.com,https://admin.example.com
WEB_ORIGIN=https://game.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
MAIL_FROM=Fishing World <noreply@example.com>
# Set true only after completing the documented legal/security release gates.
PUBLIC_RELEASE_APPROVED=false
TRUST_PROXY=loopback,linklocal,uniquelocal
