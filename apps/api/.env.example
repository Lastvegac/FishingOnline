NODE_ENV=development
PORT=3001
HOST=127.0.0.1
DATABASE_URL=postgresql://fwo:fwo_local_only@127.0.0.1:55432/fishing_world
TEST_DATABASE_URL=postgresql://fwo:fwo_local_only@127.0.0.1:55432/fishing_world_test
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
WEB_ORIGIN=http://localhost:5173
# Required in production; development explicitly uses process-local limits if absent.
REDIS_URL=
# Local Mailpit example; no reset email is claimed sent if SMTP is unavailable.
SMTP_HOST=127.0.0.1
SMTP_PORT=51025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Fishing World <noreply@example.test>
# OTP (6 digits, 10 minutes, 5 tries) is sent by email via SMTP above, by SMS via the webhook below.
# SMS: HTTPS endpoint receiving POST {"to":"+849...","message":"..."} (adapter for a Vietnamese brandname SMS gateway).
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# Google Identity Services Web client id; Google sign-in is hidden when empty.
GOOGLE_CLIENT_ID=
# Local/E2E only: keep OTP codes in memory (GET /api/v1/dev/otp-outbox?to=...). Refused in production.
OTP_DEV_OUTBOX=false
# Set only for one-time admin:bootstrap, never seed defaults.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=

# Payments: disabled by default. Never use live credentials in development/tests.
PAYMENT_ENVIRONMENT=disabled
PAYMENT_SUCCESS_URL=http://localhost:5173/play/payments
PAYMENT_CANCEL_URL=http://localhost:5173/play/payments
# Server egress IP sent in VNPay querydr; required for production VNPay.
PAYMENT_QUERY_IP=127.0.0.1
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn
MOMO_IPN_URL=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=
VNPAY_IPN_URL=
# Set these only for card rails enabled by your VNPay merchant agreement.
VNPAY_ATM_ENABLED=false
VNPAY_INTERNATIONAL_CARD_ENABLED=false
# Cards use VNPay hosted checkout. No separate card provider/keys are required.
