{
  "name": "@fwo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit.test.ts test/payments.test.ts",
    "test:integration": "vitest run test/integration.test.ts test/payments.integration.test.ts --no-file-parallelism",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --import tsx prisma/seed.ts",
    "admin:bootstrap": "node --import tsx src/bootstrap-admin.ts",
    "pricing:launch": "node --import tsx src/apply-launch-pricing.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^6.1.3",
    "@fwo/contracts": "workspace:*",
    "@fwo/game-config": "workspace:*",
    "@fwo/game-core": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.44.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "ioredis": "^5.8.2",
    "jose": "^6.2.15",
    "nodemailer": "^10.3.1",
    "pg": "^8.16.3",
    "sharp": "^0.35.5",
    "ws": "^8.22.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.27.0",
    "prisma": "7.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
