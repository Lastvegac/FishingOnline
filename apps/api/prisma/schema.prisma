// Runtime Prisma schema. SQL migrations add partial indexes and immutable ledgers.
// Target Prisma syntax 7.10.1; Foundation must audit Node compatibility before pinning.
// Connection URL belongs in future apps/api/prisma.config.ts, not this schema.
// Production identity/age/guardian/time controls need LEGAL.md review before beta.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OtpChannel {
  EMAIL
  SMS
}

enum OtpPurpose {
  REGISTER
  PROFILE_UPDATE
}

enum IdentityProvider {
  GOOGLE
}

enum AdminRole {
  SUPER_ADMIN
  GAME_ADMIN
  SUPPORT
  ANALYST
}

enum FishingState {
  IDLE
  CASTING
  WAITING
  BITE
  HOOKING
  FIGHTING
  REELING
  CAUGHT
  ESCAPED
  FINISHED
}

enum Rarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

enum EquipmentSlot {
  ROD
  LINE
  HOOK
  COSMETIC
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  // Email is immutable after registration; phone-only accounts have no email.
  emailNormalized String?   @unique @map("email_normalized") @db.VarChar(254)
  phoneE164       String?   @unique @map("phone_e164") @db.VarChar(16)
  phoneVerifiedAt DateTime? @map("phone_verified_at") @db.Timestamptz(3)
  // Null for accounts created only through Google.
  passwordHash    String?   @map("password_hash")
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  profile         UserProfile?
  sessions        UserSession[]
  passwordResets  PasswordResetToken[]
  identities      UserIdentity[]
  otpChallenges   OtpChallenge[]
  inventory       UserInventory[]
  equipment       UserEquipment[]
  collection      FishCollection[]
  fishingSessions FishingSession[]
  lakeMessages LakeMessage[]
  catches         FishingCatch[]
  wallet          Wallet?
  orders          ShopOrder[]
  missions        UserMission[]
  achievements    UserAchievement[]
  admin           AdminUser?
  auditLogs       AuditLog[]
  analytics       AnalyticsEvent[]
  idempotency     IdempotencyRecord[]
  grants          UserGrant[]
  character       PlayerCharacter?
  lakePresence    LakePresence?
  paymentOrders   PaymentOrder[]
  @@map("users")
}

model UserProfile {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  username           String   @db.VarChar(24)
  normalizedUsername String   @unique @map("normalized_username") @db.VarChar(48)
  avatarKey          String?  @map("avatar_key")
  totalXp            Int      @default(0) @map("total_xp")
  totalFish          Int      @default(0) @map("total_fish")
  largestFishG       Int      @default(0) @map("largest_fish_g")
  settings           Json
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user               User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([totalXp(sort: Desc), userId])
  @@index([largestFishG(sort: Desc), userId])
  @@map("user_profiles")
}

model UserSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  familyId   String    @map("family_id") @db.Uuid
  parentId   String?   @unique @map("parent_id") @db.Uuid
  deviceLabel String?  @map("device_label") @db.VarChar(128)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  parent     UserSession? @relation("Rotation", fields: [parentId], references: [id], onDelete: Restrict)
  child      UserSession? @relation("Rotation")
  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model UserIdentity {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  provider  IdentityProvider
  subject   String           @db.VarChar(255)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([provider, subject])
  @@index([userId])
  @@map("user_identities")
}

// One-time codes for registration and profile changes. Only an HMAC of the code is stored;
// payload holds the pending change and is cleared when consumed.
model OtpChallenge {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String?    @map("user_id") @db.Uuid
  purpose     OtpPurpose
  channel     OtpChannel
  destination String     @db.VarChar(254)
  codeHash    String     @map("code_hash")
  payload     Json
  attempts    Int        @default(0)
  sendCount   Int        @default(1) @map("send_count")
  lastSentAt  DateTime   @map("last_sent_at") @db.Timestamptz(3)
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(3)
  consumedAt  DateTime?  @map("consumed_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  user        User?      @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

// Immutable photographs remain available to historical config/catch snapshots.
model FishPhotoAsset {
  id        String   @id @default(uuid()) @db.Uuid
  checksum  String   @unique @db.VarChar(64)
  content   Bytes
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@map("fish_photo_assets")
}

model FishSpecies {
  id              String   @id @default(uuid()) @db.Uuid
  slug            String   @unique
  name            String
  description     String
  imageKey        String   @map("image_key")
  rarity          Rarity
  baseWeightG     Int      @map("base_weight_g")
  minWeightG      Int      @map("min_weight_g")
  maxWeightG      Int      @map("max_weight_g")
  baseRewardGold  BigInt   @map("base_reward_gold")
  baseXp          Int      @map("base_xp")
  habitat         String
  preferredBaits  Json     @map("preferred_baits") // Slug -> bounded affinity; Zod validates references.
  difficulty      Int
  pullStrength    Float    @map("pull_strength")
  reactionMs      Int      @map("reaction_ms")
  active          Boolean  @default(true)
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  locations       LocationFish[]
  collections     FishCollection[]
  catches         FishingCatch[]
  @@map("fish_species")
}

model FishingLocation {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique
  name         String
  environment  String
  minLevel     Int      @default(1) @map("min_level")
  entryFeeGold BigInt   @default(0) @map("entry_fee_gold")
  difficulty   Int      @default(1)
  imageKey     String   @map("image_key")
  assetConfig  Json     @map("asset_config")
  active       Boolean  @default(true)
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  fish         LocationFish[]
  sessions     FishingSession[]
  catches      FishingCatch[]
  messages     LakeMessage[]
  @@map("fishing_locations")
}

model LocationFish {
  id         String @id @default(uuid()) @db.Uuid
  locationId String @map("location_id") @db.Uuid
  fishId     String @map("fish_id") @db.Uuid
  baseWeight Float  @map("base_weight")
  conditions Json
  location   FishingLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  fish       FishSpecies @relation(fields: [fishId], references: [id], onDelete: Restrict)
  @@unique([locationId, fishId])
  @@index([fishId])
  @@map("location_fish")
}

model Equipment {
  id            String   @id @default(uuid()) @db.Uuid
  slug          String   @unique
  name          String
  slot          EquipmentSlot
  minLevel      Int      @default(1) @map("min_level")
  basePriceGold BigInt   @map("base_price_gold")
  imageKey      String   @map("image_key")
  active        Boolean  @default(true)
  version       Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  stats         EquipmentStat[]
  inventory     UserInventory[]
  shopItems     ShopItem[]
  @@map("equipment")
}

model EquipmentStat {
  id          String @id @default(uuid()) @db.Uuid
  equipmentId String @map("equipment_id") @db.Uuid
  key         String
  value       Float
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  @@unique([equipmentId, key])
  @@map("equipment_stats")
}

model BaitType {
  id               String   @id @default(uuid()) @db.Uuid
  slug             String   @unique
  name             String
  priceGold        BigInt   @map("price_gold")
  imageKey         String   @map("image_key")
  attractionConfig Json     @map("attraction_config")
  active           Boolean  @default(true)
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  inventory        UserInventory[]
  shopItems        ShopItem[]
  @@map("bait_types")
}

model UserInventory {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  equipmentId  String?  @map("equipment_id") @db.Uuid
  cosmeticId   String?  @map("cosmetic_id")
  cosmetic     CharacterCosmetic? @relation(fields: [cosmeticId], references: [id], onDelete: Restrict)
  characterEquipment CharacterEquipment[]
  baitTypeId   String?  @map("bait_type_id") @db.Uuid
  quantity     Int      @default(1)
  upgradeLevel Int      @default(0) @map("upgrade_level")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user         User @relation(fields: [userId], references: [id], onDelete: Restrict)
  equipment    Equipment? @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  bait         BaitType? @relation(fields: [baitTypeId], references: [id], onDelete: Restrict)
  equipped     UserEquipment?
  @@unique([userId, cosmeticId])
  @@index([userId, equipmentId])
  @@index([userId, baitTypeId])
  @@map("user_inventory")
}

model UserEquipment {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @map("user_id") @db.Uuid
  inventoryId String @unique @map("inventory_id") @db.Uuid
  slot        EquipmentSlot
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User @relation(fields: [userId], references: [id], onDelete: Restrict)
  inventory   UserInventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  @@unique([userId, slot])
  @@map("user_equipment")
}

model FishCollection {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  fishId        String   @map("fish_id") @db.Uuid
  count         Int      @default(0)
  bestWeightG   Int      @map("best_weight_g")
  firstCaughtAt DateTime @map("first_caught_at") @db.Timestamptz(3)
  lastCaughtAt  DateTime @map("last_caught_at") @db.Timestamptz(3)
  user          User @relation(fields: [userId], references: [id], onDelete: Restrict)
  fish          FishSpecies @relation(fields: [fishId], references: [id], onDelete: Restrict)
  @@unique([userId, fishId])
  @@map("fish_collections")
}

model FishingSession {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  locationId     String       @map("location_id") @db.Uuid
  configId       String       @map("config_id") @db.Uuid
  state          FishingState @default(IDLE)
  version        Int          @default(0)
  configSnapshot Json         @map("config_snapshot")
  secretOutcome  Json?        @map("secret_outcome")
  simulation     Json
  castAt         DateTime?    @map("cast_at") @db.Timestamptz(3)
  biteAt         DateTime?    @map("bite_at") @db.Timestamptz(3)
  hookDeadline   DateTime?    @map("hook_deadline") @db.Timestamptz(3)
  lastTickAt     DateTime?    @map("last_tick_at") @db.Timestamptz(3)
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(3)
  finishedAt     DateTime?    @map("finished_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User @relation(fields: [userId], references: [id], onDelete: Restrict)
  location       FishingLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  config         SystemConfig @relation(fields: [configId], references: [id], onDelete: Restrict)
  actions        FishingAction[]
  catch          FishingCatch?
  @@index([userId, createdAt])
  @@index([state, updatedAt])
  @@index([expiresAt])
  @@map("fishing_sessions")
}

model FishingAction {
  id             String   @id @default(uuid()) @db.Uuid
  sessionId      String   @map("session_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key") @db.Uuid
  requestHash    String   @map("request_hash")
  action         String
  expectedVersion Int     @map("expected_version")
  payload        Json
  response       Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  session        FishingSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  @@unique([sessionId, idempotencyKey])
  @@index([sessionId, createdAt])
  @@map("fishing_actions")
}

model FishingCatch {
  id            String   @id @default(uuid()) @db.Uuid
  sessionId     String   @unique @map("session_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  fishId        String   @map("fish_id") @db.Uuid
  locationId    String   @map("location_id") @db.Uuid
  weightG       Int      @map("weight_g")
  rarity        Rarity
  rewardGold    BigInt   @map("reward_gold")
  rewardXp      Int      @map("reward_xp")
  rewardSnapshot Json    @map("reward_snapshot")
  goldClaimed   Boolean  @default(true) @map("gold_claimed")
  exchangedAt   DateTime? @map("exchanged_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  session       FishingSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  user          User @relation(fields: [userId], references: [id], onDelete: Restrict)
  fish          FishSpecies @relation(fields: [fishId], references: [id], onDelete: Restrict)
  location      FishingLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  @@index([userId, createdAt])
  @@index([userId, goldClaimed, createdAt])
  @@index([locationId, createdAt])
  @@index([userId, exchangedAt])
  @@index([fishId, weightG(sort: Desc)])
  @@index([userId, fishId, weightG(sort: Desc), createdAt, id])
  @@map("fishing_catches")
}

model Wallet {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  balanceGold  BigInt   @default(0) @map("balance_gold")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  balanceDiamonds BigInt @default(0) @map("balance_diamonds")
  user         User @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions WalletTransaction[]
  @@map("wallets")
}

model WalletTransaction {
  id               String   @id @default(uuid()) @db.Uuid
  walletId         String   @map("wallet_id") @db.Uuid
  deltaGold        BigInt   @map("delta_gold")
  balanceAfterGold BigInt   @map("balance_after_gold")
  reason           String
  referenceType    String   @map("reference_type")
  referenceId      String   @map("reference_id")
  idempotencyKey   String   @map("idempotency_key")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  wallet           Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  @@unique([walletId, idempotencyKey])
  @@unique([walletId, reason, referenceType, referenceId])
  @@index([walletId, createdAt, id])
  @@map("wallet_transactions")
}

model ShopItem {
  id          String   @id @default(uuid()) @db.Uuid
  equipmentId String?  @map("equipment_id") @db.Uuid
  baitTypeId  String?  @map("bait_type_id") @db.Uuid
  priceGold   BigInt   @map("price_gold")
  grantQuantity Int    @default(1) @map("grant_quantity") // E.g. one worm pack grants 10 bait units.
  stock       Int?
  minLevel    Int      @default(1) @map("min_level")
  active      Boolean  @default(true)
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  equipment   Equipment? @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  bait        BaitType? @relation(fields: [baitTypeId], references: [id], onDelete: Restrict)
  orders      ShopOrder[]
  @@map("shop_items")
}

model ShopOrder {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  shopItemId     String   @map("shop_item_id") @db.Uuid
  quantity       Int
  unitPriceGold  BigInt   @map("unit_price_gold")
  totalGold      BigInt   @map("total_gold")
  itemSnapshot   Json     @map("item_snapshot")
  idempotencyKey String   @map("idempotency_key") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User @relation(fields: [userId], references: [id], onDelete: Restrict)
  item           ShopItem @relation(fields: [shopItemId], references: [id], onDelete: Restrict)
  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@map("shop_orders")
}

model Mission {
  id         String   @id @default(uuid()) @db.Uuid
  key        String   @unique
  name       String
  eventType  String   @map("event_type")
  target     Int
  rewardGold BigInt   @map("reward_gold")
  rewardXp   Int      @map("reward_xp")
  active     Boolean  @default(true)
  version    Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  players    UserMission[]
  @@map("missions")
}

model UserMission {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  missionId      String    @map("mission_id") @db.Uuid
  periodKey      String    @map("period_key") @db.VarChar(64)
  progress       Int       @default(0)
  rewardSnapshot Json      @map("reward_snapshot")
  criteriaSnapshot Json    @map("criteria_snapshot") // Frozen target/event/filter for this occurrence.
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(3)
  claimedAt      DateTime? @map("claimed_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User @relation(fields: [userId], references: [id], onDelete: Restrict)
  mission        Mission @relation(fields: [missionId], references: [id], onDelete: Restrict)
  @@unique([userId, missionId, periodKey])
  @@map("user_missions")
}

model Achievement {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  name      String
  criteria  Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  players   UserAchievement[]
  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  achievementId String   @map("achievement_id") @db.Uuid
  unlockedAt    DateTime @default(now()) @map("unlocked_at") @db.Timestamptz(3)
  user          User @relation(fields: [userId], references: [id], onDelete: Restrict)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Restrict)
  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model AdminUser {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @unique @map("user_id") @db.Uuid
  role      AdminRole
  version   Int       @default(1)
  mfaEnabled Boolean  @default(false) @map("mfa_enabled")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@map("admin_users")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  actorSnapshot Json    @map("actor_snapshot")
  action       String
  targetType   String   @map("target_type")
  targetId     String   @map("target_id")
  before       Json?
  after        Json?
  reason       String?
  requestId    String   @map("request_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor        User? @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("audit_logs")
}

model SystemConfig {
  id            String    @id @default(uuid()) @db.Uuid
  key           String
  version       Int
  schemaVersion Int       @map("schema_version")
  value         Json
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  isActive      Boolean   @default(false) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  sessions      FishingSession[]
  @@unique([key, version])
  @@index([key, isActive])
  @@map("system_configs")
}

model IdempotencyRecord {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  route        String
  key          String   @db.Uuid
  requestHash  String   @map("request_hash")
  statusCode   Int      @map("status_code")
  response     Json
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)
  user         User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([userId, route, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model AnalyticsEvent {
  id         String   @id @default(uuid()) @db.Uuid
  eventId    String   @unique @map("event_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  eventName  String   @map("event_name")
  source     String   // SERVER or CLIENT; CLIENT cannot issue rewards.
  properties Json
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  attempts    Int      @default(0)
  user       User? @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([eventName, occurredAt])
  @@index([userId, occurredAt])
  @@index([processedAt, createdAt])
  @@map("analytics_events")
}

model UserGrant {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  key       String   // e.g. DAILY_BAIT_RESCUE
  periodKey String   @map("period_key") @db.VarChar(64)
  payload   Json     // Immutable granted item/quantity/config reference, no secret.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([userId, key, periodKey])
  @@map("user_grants")
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  EXPIRED
}

enum PaymentOrderStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  EXPIRED
}

enum PaymentGateway {
  MOMO
  VNPAY
}

// Explicit VND catalog; Gold prices/configuration are never converted to fiat.
model PaymentProduct {
  id          String @id @default(uuid()) @db.Uuid
  name        String @db.VarChar(120)
  description String @db.VarChar(1000)
  amountVnd   BigInt @map("amount_vnd")
  active      Boolean @default(false)
  version     Int @default(1)
  items       Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  orders      PaymentOrder[]
  @@map("payment_products")
}

model PaymentOrder {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @map("user_id") @db.Uuid
  productId   String @map("product_id") @db.Uuid
  orderCode   String @unique @map("order_code") @db.VarChar(40)
  productName String @map("product_name")
  totalAmount BigInt @map("total_amount")
  currency    String @default("VND") @db.VarChar(3)
  status      PaymentOrderStatus @default(PENDING)
  quantity    Int
  idempotencyKey String @map("idempotency_key") @db.Uuid
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)
  paidAt      DateTime? @map("paid_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User @relation(fields: [userId], references: [id], onDelete: Restrict)
  product     PaymentProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  items       PaymentOrderItem[]
  transaction PaymentTransaction?
  outbox      PaymentOutbox[]
  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt, id])
  @@index([status, expiresAt])
  @@map("payment_orders")
}

model PaymentOrderItem {
  id          String @id @default(uuid()) @db.Uuid
  orderId     String @map("order_id") @db.Uuid
  itemId      String @map("item_id") @db.Uuid
  name        String
  kind        String
  quantity    Int
  imageKey    String @map("image_key")
  order       PaymentOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  fulfillment PaymentFulfillmentLog?
  @@unique([orderId, itemId])
  @@map("payment_order_items")
}

model PaymentTransaction {
  id          String @id @default(uuid()) @db.Uuid
  orderId     String @unique @map("order_id") @db.Uuid
  gateway     PaymentGateway
  method      String
  gatewayTransactionId String? @map("gateway_transaction_id")
  amount      BigInt
  status      PaymentStatus @default(PENDING)
  paymentUrl  String? @map("payment_url")
  checkoutLeaseAt DateTime? @map("checkout_lease_at") @db.Timestamptz(3)
  gatewayResponse Json? @map("gateway_response")
  paidAt      DateTime? @map("paid_at") @db.Timestamptz(3)
  lastQueriedAt DateTime? @map("last_queried_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  order       PaymentOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@unique([gateway, gatewayTransactionId])
  @@index([status, lastQueriedAt])
  @@map("payment_transactions")
}

model PaymentWebhookLog {
  id          String @id @default(uuid()) @db.Uuid
  gateway     PaymentGateway
  orderCode   String? @map("order_code")
  payload     Json
  payloadHash String @map("payload_hash")
  signatureValid Boolean @map("signature_valid")
  processingStatus String @map("processing_status")
  receivedAt  DateTime @default(now()) @map("received_at") @db.Timestamptz(3)
  @@index([orderCode, receivedAt])
  @@map("payment_webhook_logs")
}

model PaymentFulfillmentLog {
  id          String @id @default(uuid()) @db.Uuid
  orderItemId String @unique @map("order_item_id") @db.Uuid
  userId      String @map("user_id") @db.Uuid
  inventoryId String? @map("inventory_id") @db.Uuid
  diamondTransactionId String? @unique @map("diamond_transaction_id") @db.Uuid
  quantity    Int
  fulfilledAt DateTime @map("fulfilled_at") @db.Timestamptz(3)
  item        PaymentOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  @@index([userId, fulfilledAt])
  @@map("payment_fulfillment_logs")
}

model PaymentOutbox {
  id          String @id @default(uuid()) @db.Uuid
  orderId     String @map("order_id") @db.Uuid
  userId      String @map("user_id") @db.Uuid
  key         String @unique
  type        String
  payload     Json
  attempts    Int @default(0)
  availableAt DateTime @default(now()) @map("available_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  lastError   String? @map("last_error")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  order       PaymentOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@index([processedAt, availableAt])
  @@map("payment_outbox")
}


// One main character per account. Separate identity allows later character slots.
model PlayerCharacter {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  name String @db.VarChar(24)
  presetId String @map("preset_id")
  appearance Json
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  preset CharacterPreset @relation(fields: [presetId], references: [id], onDelete: Restrict)
  equipment CharacterEquipment[]
  @@map("player_characters")
}
model CharacterPreset {
  id String @id
  appearance Json
  equipment Json
  animation String
  previewAsset String @map("preview_asset")
  characters PlayerCharacter[]
  @@map("character_presets")
}
model CharacterCosmetic {
  id String @id
  slot String
  assetId String @map("asset_id")
  nameVi String @default("") @map("name_vi")
  nameEn String @default("") @map("name_en")
  descriptionVi String @default("") @map("description_vi")
  descriptionEn String @default("") @map("description_en")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  rarity String @default("COMMON")
  unlockType String @map("unlock_type")
  priceGold BigInt @default(0) @map("price_gold")
  priceDiamonds BigInt @default(0) @map("price_diamonds")
  collectionId String? @map("collection_id")
  version Int @default(1)
  startsAt DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt DateTime? @map("ends_at") @db.Timestamptz(3)
  minLevel Int @default(1) @map("min_level")
  active Boolean @default(true)
  inventory UserInventory[]
  @@map("character_cosmetics")
}
model CharacterEquipment {
  id String @id @default(uuid()) @db.Uuid
  characterId String @map("character_id") @db.Uuid
  inventoryId String @map("inventory_id") @db.Uuid
  slot String
  equippedAt DateTime @default(now()) @map("equipped_at") @db.Timestamptz(3)
  character PlayerCharacter @relation(fields: [characterId], references: [id], onDelete: Restrict)
  inventory UserInventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  @@unique([characterId, slot])
  @@map("character_equipment")
}
model LakePresence {
  userId String @id @map("user_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid
  leaseId String @unique @map("lease_id") @db.Uuid
  sequence Int @default(0)
  x Float @default(-4)
  z Float @default(3)
  action String @default("IDLE")
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([locationId, updatedAt])
  @@map("lake_presence")
}

model DiamondTransaction {
 id String @id @default(uuid()) @db.Uuid
 userId String @map("user_id") @db.Uuid
 amount BigInt
 balanceAfter BigInt @map("balance_after")
 reason String
 reference String @unique
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 @@index([userId, createdAt])
 @@map("diamond_transactions")
}
model PlayerOutfit {
 id String @id @default(uuid()) @db.Uuid
 userId String @map("user_id") @db.Uuid
 name String @db.VarChar(40)
 appearance Json
 equipment Json
 isPublic Boolean @default(false) @map("is_public")
 version Int @default(1)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
 likes OutfitLike[]
 @@index([userId, updatedAt])
 @@index([isPublic, updatedAt])
 @@map("player_outfits")
}
model OutfitLike {
 outfitId String @map("outfit_id") @db.Uuid
 userId String @map("user_id") @db.Uuid
 outfit PlayerOutfit @relation(fields:[outfitId], references:[id], onDelete:Cascade)
 @@id([outfitId,userId])
 @@map("outfit_likes")
}
model FashionFollow {
 userId String @map("user_id") @db.Uuid
 targetId String @map("target_id") @db.Uuid
 @@id([userId,targetId])
 @@map("fashion_follows")
}
model FashionCollection {
 id String @id
 name String
 description String
 itemIds Json @map("item_ids")
 discountPercent Int @map("discount_percent")
 active Boolean @default(true)
 version Int @default(1)
 @@map("fashion_collections")
}
model FashionEvent {
 id String @id @default(uuid()) @db.Uuid
 name String
 theme String
 startsAt DateTime @map("starts_at") @db.Timestamptz(3)
 endsAt DateTime @map("ends_at") @db.Timestamptz(3)
 rewardGold BigInt @map("reward_gold")
 rewardCosmeticId String? @map("reward_cosmetic_id")
 active Boolean @default(false)
 version Int @default(1)
 entries FashionEventEntry[]
 @@map("fashion_events")
}
model FashionEventEntry {
 id String @id @default(uuid()) @db.Uuid
 eventId String @map("event_id") @db.Uuid
 userId String @map("user_id") @db.Uuid
 outfitSnapshot Json @map("outfit_snapshot")
 claimedAt DateTime? @map("claimed_at") @db.Timestamptz(3)
 event FashionEvent @relation(fields:[eventId], references:[id], onDelete:Restrict)
 votes FashionEventVote[]
 @@unique([eventId,userId])
 @@map("fashion_event_entries")
}
model FashionEventVote {
 eventId String @map("event_id") @db.Uuid
 userId String @map("user_id") @db.Uuid
 entryId String @map("entry_id") @db.Uuid
 entry FashionEventEntry @relation(fields:[entryId], references:[id], onDelete:Restrict)
 @@id([eventId,userId])
 @@map("fashion_event_votes")
}


model LakeMessage {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid
  text String @db.VarChar(280)
  catchSnapshot Json? @map("catch_snapshot")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  location FishingLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  @@index([locationId, createdAt, id])
  @@index([userId, createdAt])
  @@map("lake_messages")
}

model FashionPass {
 id String @id @default(uuid()) @db.Uuid
 name String
 kind String
 startsAt DateTime @map("starts_at") @db.Timestamptz(3)
 endsAt DateTime @map("ends_at") @db.Timestamptz(3)
 priceDiamonds BigInt @map("price_diamonds")
 tiers Json
 active Boolean @default(false)
 version Int @default(1)
 @@map("fashion_passes")
}
